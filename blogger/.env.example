# Copy this file to .env and fill in the values

# MongoDB connection string (local server or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/blogify

# Long random string used to sign login tokens. Never commit the real one.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION=1h
PORT=5000

# Optional
# CLIENT_ORIGIN=http://localhost:5173   # front ends allowed to call the API from another origin
# COOKIE_SECURE=true                    # defaults to true when NODE_ENV=production
# AUTH_RATE_LIMIT=10                    # failed logins/signups allowed per IP per 15 minutes
# TRUST_PROXY=1                         # set when running behind Nginx or a cloud load balancer
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/blogify_test   # database used by npm test
